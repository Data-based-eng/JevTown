      "choices": [
        {
          "id": "permit",
          "text": "Get pass",
          "effects": [
            {
              "op": "set",
              "var": "has_pass",
              "value": true
            }
          ]
        },
        {
          "id": "service",
          "text": "Room service (pay 0:30:00, overdraft allowed)",
          "effects": [
            {
              "op": "pay_time",
              "seconds": 1800
            }
          ]
        }
      ]
    },
    "room.exit": {
      "text": "This door leads to the co-living corridor. Pass required.",
      "choices": [
        {
          "id": "enter",
          "text": "Enter corridor",
          "when": {
            "var": "has_pass",
            "equals": true
          },
          "effects": [
            {
              "op": "travel"
            }
          ]
        }
      ]
    },
    "corridor.return": {
      "text": "Return to your room?",
      "choices": [
        {
          "id": "return",
          "text": "Return to 404",
          "effects": [
            {
              "op": "travel"
            }
          ]
        }
      ]
    }
  },
  "tasks": [
    {
      "id": "welcome",
      "title": "Get to know the town",
      "description": "Learn the controls first, then say hi to N-07 nearby. Explore freely.",
      "steps": [
        {
          "id": "walk",
          "text": "Move with WASD / arrow keys",
          "condition": {
            "event": "movement.completed",
            "collect": "direction",
            "count": 4,
            "items": [
              {
                "value": "up",
                "label": "↑ W / ↑"
              },
              {
                "value": "left",
                "label": "← A / ←"
              },
              {
                "value": "down",
                "label": "↓ S / ↓"
              },
              {
                "value": "right",
                "label": "→ D / →"
              }
            ]
          }
        },
        {
          "id": "talk",
          "text": "Approach N-07, press E to talk",
          "condition": {
            "event": "interaction.started",
            "where": {
              "entityId": "n07"
