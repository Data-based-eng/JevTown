# --- Fully-local JevTown (docs/13) ---
# Action decider: laya (local System One) | jev (TypeSafe cloud) | llm (chat-model fallback)
VITE_ACTION_DECIDER=laya

# Local System One backend. The proxy routes here when the browser's decider is `laya`
# (each /systemone call carries backend:"laya"; see server/model/jev.ts).
LAYA_ENDPOINT=http://127.0.0.1:8765
# Pinned checkpoint; laya-server --models must include typed-decisions for this name.
LAYA_MODEL=laya-typed-decisions

# TypeSafe cloud backend. The proxy routes here when the decider is `jev`
# (npm run play:local:jev). Needs a real key; independent of the LAYA_* lines above.
JEV_API_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-1.13.0

# Dialogue / memory / beliefs: any OpenAI-compatible endpoint. Ollama, local:
#   1. install Ollama (https://ollama.com), then: ollama pull llama3.1:8b nomic-embed-text
#   2. leave these as-is.
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
LLM_EMBEDDING_API_URL=http://localhost:11434/v1
LLM_EMBEDDING_API_KEY=ollama
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_EMBEDDING_PROVIDER=ollama

# No embedding backend at all? Skip memory rather than failing on it.
# VITE_DISABLE_MEMORY=true
